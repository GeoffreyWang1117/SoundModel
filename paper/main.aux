\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Data Generation Pipeline}{3}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System architecture for audio-augmented LLM training. The pipeline consists of three stages: (1) Data Generation using GPT-4 teacher and XTTS v2 TTS, (2) Feature Extraction using either acoustic features (46D) or WavLM embeddings (256D), and (3) Student Training with emotion projection and LoRA-adapted Qwen2.5-1.5B. Key findings highlight that compact acoustic features outperform deep embeddings for in-domain tasks, but cross-speaker generalization remains a critical challenge (38.5× performance degradation).}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{4}{System architecture for audio-augmented LLM training. The pipeline consists of three stages: (1) Data Generation using GPT-4 teacher and XTTS v2 TTS, (2) Feature Extraction using either acoustic features (46D) or WavLM embeddings (256D), and (3) Student Training with emotion projection and LoRA-adapted Qwen2.5-1.5B. Key findings highlight that compact acoustic features outperform deep embeddings for in-domain tasks, but cross-speaker generalization remains a critical challenge (38.5× performance degradation)}{figure.caption.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][3][]4}}
